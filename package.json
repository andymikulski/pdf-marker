{
  "name": "pdf-marker",
  "productName": "PDF Marker",
  "private": true,
  "version": "0.4.1",
  "description": "Stamp circles, X's, checks and text onto any PDF (including scans) and export a flattened copy.",
  "author": "PDF Marker",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-export.mjs && node scripts/test-resize.mjs && node scripts/test-strike.mjs && node scripts/test-clipboard.mjs",
    "test:e2e": "node scripts/make-sample-form.mjs && vite build && electron electron/smoke.cjs",
    "electron": "vite build && electron .",
    "electron:dev": "electron . --dev",
    "package": "npm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "local.pdf-marker",
    "productName": "PDF Marker",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "artifactName": "PDF-Marker-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/homemade-apple": "^5.3.0",
    "@fontsource/indie-flower": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/nothing-you-could-do": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@fontsource/shadows-into-light": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=20.19"
  },
  "license": "MIT"
}
